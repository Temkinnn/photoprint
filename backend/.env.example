# PostgreSQL connection
POSTGRES_USER=postgres
POSTGRES_PASSWORD="postgrespassword "
POSTGRES_SERVER=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=photoprint

# Режим маршрутизации AI: auto (приоритет локальным нейронкам, иначе AI_SERVER_URL), local, remote
AI_MODE=auto

# URL удаленного AI-сервера (ai/server.py через loca.lt / Cloudflare Tunnel)
# В режиме auto используется автоматически, если локальные Ollama/Whisper не запущены
# AI_SERVER_URL=https://mighty-bikes-hammer.loca.lt
LOCAL_AI_SERVER_URL=http://127.0.0.1:8001
WHISPER_MODEL_SIZE=medium

# Прямая локальная Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_TIMEOUT_SECONDS=60.0
ALLOW_FALLBACK=false
